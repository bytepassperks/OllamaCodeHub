{
  "name": "ollamacodehub-backend",
  "version": "1.0.0",
  "description": "OllamaCodeHub API — proxy to Ollama with auth, admin, and Stripe",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:migrate": "npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:push": "npx prisma db push",
    "lint": "echo 'No linter configured'"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/helmet": "^13.0.0",
    "@prisma/client": "^6.5.0",
    "@clerk/backend": "^1.21.0",
    "stripe": "^17.6.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "prisma": "^6.5.0"
  }
}
